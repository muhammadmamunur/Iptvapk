<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050C08">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Centered branding title -->
        <LinearLayout
            android:id="@+id/brandLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="KhelaGhor"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Categories Tab List View (All, Cricket, Football, Others) -->
    <HorizontalScrollView
        android:id="@+id/categoryScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Category "All" -->
            <LinearLayout
                android:id="@+id/btnCatAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleCatAll"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_active">

                    <!-- Green active stroke container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgCatAll"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:src="@drawable/ic_whistle"
                            app:tint="#10D070" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCatAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="All"
                    android:textColor="#10D070"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Category "Cricket" -->
            <LinearLayout
                android:id="@+id/btnCatCricket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleCatCricket"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_inactive">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgCatCricket"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:src="@drawable/ic_cricket"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCatCricket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Cricket"
                    android:textColor="#A0A5A2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Category "Football" -->
            <LinearLayout
                android:id="@+id/btnCatFootball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleCatFootball"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_inactive">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgCatFootball"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:src="@drawable/ic_football"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCatFootball"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Football"
                    android:textColor="#A0A5A2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Category "Others" -->
            <LinearLayout
                android:id="@+id/btnCatOthers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/circleCatOthers"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_inactive">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgCatOthers"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:padding="12dp"
                            android:src="@drawable/ic_others"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCatOthers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Others"
                    android:textColor="#A0A5A2"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Top line divider -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#15241C"
        app:layout_constraintTop_toBottomOf="@id/categoryScrollView" />

    <!-- Matches RecyclerView List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMatches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@id/bannerAdCard"
        app:layout_constraintTop_toBottomOf="@id/dividerLine"
        tools:listitem="@layout/match_item" />

    <!-- Sponsors Banner Ad -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bannerAdCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#0B1A13"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationBar">

        <FrameLayout
            android:id="@+id/bannerAdContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/bannerWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/fallbackBannerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:id="@+id/adBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="#10D070"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="SPONSOR"
                    android:textColor="#050C08"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/adBadge"
                    android:fontFamily="sans-serif-medium"
                    android:text="KhelaGhor HD live stream servers online!"
                    android:textColor="#E0E5E2"
                    android:textSize="12sp" />
            </RelativeLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#05140D"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Nav Item 1: Live Match (Selected state by default) -->
        <LinearLayout
            android:id="@+id/navLive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Pill Container for Match Highlight -->
            <FrameLayout
                android:id="@+id/pillLive"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp">

                <!-- Simple background color circle overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

                <!-- Vector Icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_football"
                    app:tint="#05140D" />
            </FrameLayout>

            <TextView
                android:id="@+id/textLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Live Match"
                android:textColor="#10D070"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nav Item 2: Categories -->
        <LinearLayout
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillCategories"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_categories"
                    app:tint="#A0A5A2" />
            </FrameLayout>

            <TextView
                android:id="@+id/textCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Categories"
                android:textColor="#A0A5A2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Nav Item 3: Upcoming -->
        <LinearLayout
            android:id="@+id/navUpcoming"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillUpcoming"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clock"
                    app:tint="#A0A5A2" />
            </FrameLayout>

            <TextView
                android:id="@+id/textUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Upcoming"
                android:textColor="#A0A5A2"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
